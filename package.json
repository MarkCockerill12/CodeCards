{
  "name": "codecards",
  "version": "1.0.0",
  "private": true,
  "description": "CodeCards - the ultimate spaced-repetition study platform for software engineering.",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "verify": "node scripts/verify-code.mjs",
    "links": "node scripts/check-links.mjs",
    "dev": "npm run content && next dev",
    "build": "npm run content && next build",
    "start": "next start",
    "lint": "oxlint src scripts",
    "typecheck": "tsc --noEmit",
    "check": "npm run content && npm run verify && npm run lint && npm run typecheck",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.460.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ts-fsrs": "^4.4.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "oxlint": "^0.15.0",
    "playwright": "^1.49.0",
    "shiki": "^1.24.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "zod": "^3.24.0"
  }
}
